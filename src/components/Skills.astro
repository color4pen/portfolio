---
import { getCollection } from 'astro:content';

// Collect all unique technologies from experiences and projects
const experiences = await getCollection('experience');
const projects = await getCollection('projects');

// Group technologies by category
const categories = new Map<string, Set<string>>();

experiences.forEach((exp) => {
  exp.data.tech?.forEach((tech) => {
    if (!categories.has(tech.category)) {
      categories.set(tech.category, new Set());
    }
    categories.get(tech.category)!.add(tech.name);
  });
});

projects.forEach((project) => {
  project.data.tech.forEach((tech) => {
    if (!categories.has(tech.category)) {
      categories.set(tech.category, new Set());
    }
    categories.get(tech.category)!.add(tech.name);
  });
});

// Convert to array format and sort
const skillCategories = Array.from(categories.entries())
  .map(([title, skills]) => ({
    title,
    skills: Array.from(skills).sort(),
  }))
  .sort((a, b) => {
    const order = ['Frontend', 'Backend', 'Database', 'Infrastructure', 'Tools'];
    return order.indexOf(a.title) - order.indexOf(b.title);
  });
---

<section id="skills" class="pt-12 pb-16 md:pt-16 md:pb-24 lg:pt-20 lg:pb-32">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-12 md:mb-16">
      <span class="text-sm md:text-base font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider block mb-4">What I Do</span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-6">Technical Skills</h2>
      <div class="w-24 h-1.5 bg-gradient-to-r from-primary-600 to-primary-400 mx-auto rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {skillCategories.map((category) => (
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-6 md:p-8">
          <h3 class="text-2xl md:text-3xl font-bold mb-4 text-primary-600 dark:text-primary-400">{category.title}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="px-4 py-2 bg-gray-100 dark:bg-gray-700 rounded-full text-sm font-medium">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

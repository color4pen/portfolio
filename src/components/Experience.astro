---
import { getCollection } from 'astro:content';

const experiences = await getCollection('experience');
const sortedExperiences = experiences.sort((a, b) => {
  // Sort by period (most recent first)
  // This is a simple sort, you might want to parse the period for better sorting
  return b.data.period.localeCompare(a.data.period);
});
---

<section id="experience" class="pt-12 pb-16 md:pt-16 md:pb-24 lg:pt-20 lg:pb-32 bg-gray-50 dark:bg-gray-800">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-6">Work Experience</h2>
      <div class="w-24 h-1.5 bg-gradient-to-r from-primary-600 to-primary-400 mx-auto rounded-full"></div>
    </div>
    <div class="max-w-3xl mx-auto space-y-8 md:space-y-10">
      {sortedExperiences.map((exp) => (
        <a id={`experience-${exp.slug}`} href={`${import.meta.env.BASE_URL}/experience/${exp.slug}`.replace('//', '/')} class="block bg-white dark:bg-gray-800 rounded-xl shadow-xl hover:shadow-2xl border-2 border-gray-100 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-600 transition-all duration-300 p-8 md:p-10 group">
          <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-4">
            <div class="flex-1">
              <h3 class="text-2xl font-bold mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{exp.data.title}</h3>
              <div class="flex flex-wrap items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                <span class="font-medium">{exp.data.position}</span>
                <span class="text-gray-400 dark:text-gray-600">•</span>
                <span>{exp.data.company}</span>
              </div>
            </div>
            <span class="text-gray-600 dark:text-gray-400 font-medium mt-2 md:mt-0 whitespace-nowrap md:ml-4">{exp.data.period}</span>
          </div>
          {exp.data.achievements && exp.data.achievements.length > 0 && (
            <ul class="list-disc list-inside space-y-1 text-gray-600 dark:text-gray-400 mb-4">
              {exp.data.achievements.map((achievement) => (
                <li class="leading-relaxed">{achievement}</li>
              ))}
            </ul>
          )}
          <div class="flex items-end justify-between">
            <div class="hidden md:flex flex-wrap gap-2">
              {exp.data.tech && exp.data.tech.length > 0 && exp.data.tech.slice(0, 3).map((tech) => (
                <span class="px-3 py-1 bg-primary-50 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium">
                  {tech.name}
                </span>
              ))}
              {exp.data.tech && exp.data.tech.length > 3 && (
                <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium">
                  +{exp.data.tech.length - 3}
                </span>
              )}
            </div>
            <div class="text-primary-600 dark:text-primary-400 font-medium flex items-center gap-2 ml-auto flex-shrink-0">
              <span>詳細を見る</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

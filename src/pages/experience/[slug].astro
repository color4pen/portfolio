---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const experiences = await getCollection('experience');
  return experiences.map((experience) => ({
    params: { slug: experience.slug },
    props: { experience },
  }));
}

const { experience } = Astro.props;
const { Content } = await experience.render();
---

<Layout title={`${experience.data.title} - Portfolio`} description={experience.data.description}>
  <article class="pt-12 pb-16 md:pt-16 md:pb-24 lg:pt-20 lg:pb-32">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 lg:px-12">
      <a href={`${import.meta.env.BASE_URL}/#experience-${experience.slug}`.replace('//', '/')} class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:underline mb-8 md:mb-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Experience
      </a>

      <header class="mb-10 md:mb-12">
        <div class="mb-6">
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4">{experience.data.title}</h1>
          <div class="flex flex-wrap items-center gap-3 text-base text-gray-600 dark:text-gray-400">
            <span class="font-semibold text-primary-600 dark:text-primary-400">{experience.data.position}</span>
            <span class="text-gray-400 dark:text-gray-600">•</span>
            <span>{experience.data.company}</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 mb-6 md:mb-8 text-gray-600 dark:text-gray-400">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>{experience.data.period}</span>
          </div>
        </div>

        <p class="text-xl text-gray-600 dark:text-gray-400 mb-6 md:mb-8">
          {experience.data.description}
        </p>

        {experience.data.tech && (
          <div>
            <h2 class="text-lg font-semibold mb-3">Technologies Used</h2>
            <div class="flex flex-wrap gap-2">
              {experience.data.tech.map((tech) => (
                <span class="px-4 py-2 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-lg text-sm font-medium">
                  {tech.name}
                </span>
              ))}
            </div>
          </div>
        )}
      </header>

      <div class="prose prose-lg dark:prose-invert max-w-none">
        <Content />
      </div>

      {experience.data.achievements.length > 0 && (
        <div class="mt-10 md:mt-12 p-6 md:p-8 bg-gray-50 dark:bg-gray-800 rounded-xl">
          <h2 class="text-2xl font-bold mb-4">Key Achievements</h2>
          <ul class="space-y-2">
            {experience.data.achievements.map((achievement) => (
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-gray-700 dark:text-gray-300">{achievement}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </article>
</Layout>

<style>
  :global(.prose) {
    @apply text-gray-700 dark:text-gray-300;
  }

  :global(.prose h2) {
    @apply text-2xl font-bold mt-8 mb-4 text-gray-900 dark:text-gray-100;
  }

  :global(.prose h3) {
    @apply text-xl font-bold mt-6 mb-3 text-gray-900 dark:text-gray-100;
  }

  :global(.prose p) {
    @apply mb-4;
  }

  :global(.prose ul, .prose ol) {
    @apply mb-4 pl-6;
  }

  :global(.prose li) {
    @apply mb-2;
  }

  :global(.prose a) {
    @apply text-primary-600 dark:text-primary-400 hover:underline;
  }

  :global(.prose strong) {
    @apply font-semibold text-gray-900 dark:text-gray-100;
  }

  :global(.prose code) {
    @apply bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded text-sm;
  }

  :global(.prose pre) {
    @apply bg-gray-100 dark:bg-gray-800 p-4 rounded-lg overflow-x-auto mb-4;
  }
</style>
